; AuralWeave Virtual Audio Kernel Prototype — derivative of Microsoft SimpleAudioSample.
; Copyright (c) Microsoft Corporation. All Rights Reserved.
; Derived portions licensed under Microsoft Public License (MS-PL).
; THIS FILE IS A PROTOTYPE ONLY. NOT VALIDATED, NOT SIGNED, NOT INSTALLABLE.
; Windows 10 and Windows 11 both report the NT 10.0 OS version.
; Only ROOT\AURALWEAVE_VINPUT_0001 and ROOT\AURALWEAVE_VOUTPUT_0001 are supported.

[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 11/25/2026, 0.3.0.0
CatalogFile = AuralWeaveVirtualAudio.cat
PnpLockDown = 1

[SourceDisksNames]
222 = "AuralWeave Virtual Audio Prototype","",222

[SourceDisksFiles]
AuralWeaveVirtualAudio.sys = 222

; NTamd64.10.0...19041 matches supported Windows 10 builds and Windows 11 x64.
[Manufacturer]
%MfgName% = AW,NTamd64.10.0...19041

[AW.NTamd64.10.0...19041]
%AW.Input.0001% = AW_Input, ROOT\AURALWEAVE_VINPUT_0001
%AW.Output.0001% = AW_Output, ROOT\AURALWEAVE_VOUTPUT_0001

[DestinationDirs]
AW.CopyList = 13

[AW.CopyList]
AuralWeaveVirtualAudio.sys

[AW.Common.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,AuralWeaveVirtualAudio.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
; Device system defaults should not be silently changed.
HKR,PowerSettings,ConservationIdleTime,0x00010001,3
HKR,PowerSettings,PerformanceIdleTime,0x00010001,3
HKR,PowerSettings,IdlePowerState,0x00010001,3

; Each role's INF section registers ONLY its respective Windows endpoint.
[AW_Input.NT]
Include = ks.inf,wdmaudio.inf
Needs = KS.Registration,WDMAUDIO.Registration
CopyFiles = AW.CopyList
AddReg = AW.Common.AddReg

[AW_Output.NT]
Include = ks.inf,wdmaudio.inf
Needs = KS.Registration,WDMAUDIO.Registration
CopyFiles = AW.CopyList
AddReg = AW.Common.AddReg

[AW_Input.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveMicArray1%, AW.I.WaveMic
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveMicArray1%, AW.I.WaveMic
AddInterface=%KSCATEGORY_CAPTURE%, %KSNAME_WaveMicArray1%, AW.I.WaveMic
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologyMicArray1%, AW.I.TopologyMic
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologyMicArray1%, AW.I.TopologyMic

[AW_Output.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_WaveSpeaker%, AW.I.WaveSpeaker
AddInterface=%KSCATEGORY_RENDER%, %KSNAME_WaveSpeaker%, AW.I.WaveSpeaker
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_WaveSpeaker%, AW.I.WaveSpeaker
AddInterface=%KSCATEGORY_AUDIO%, %KSNAME_TopologySpeaker%, AW.I.TopologySpeaker
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_TopologySpeaker%, AW.I.TopologySpeaker

[AW.I.WaveMic]
AddReg = AW.I.WaveMic.Reg

[AW.I.WaveMic.Reg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AW.Input.Friendly%

[AW.I.TopologyMic]
AddReg = AW.I.TopologyMic.Reg

[AW.I.TopologyMic.Reg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AW.Input.Topology%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

[AW.I.WaveSpeaker]
AddReg = AW.I.WaveSpeaker.Reg

[AW.I.WaveSpeaker.Reg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AW.Output.Friendly%

[AW.I.TopologySpeaker]
AddReg = AW.I.TopologySpeaker.Reg

[AW.I.TopologySpeaker.Reg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%AW.Output.Topology%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

[AW_Input.NT.Services]
AddService=AuralWeaveVirtualAudio,0x00000002,AW.Service

[AW_Output.NT.Services]
AddService=AuralWeaveVirtualAudio,0x00000002,AW.Service

[AW.Service]
DisplayName=%AW.Service.Desc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\AuralWeaveVirtualAudio.sys

[AW_Input.NT.HW]
AddReg = AW.Hardware.Reg

[AW_Output.NT.HW]
AddReg = AW.Hardware.Reg

[AW.Hardware.Reg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x00010001,0x0000001D
; Derived from the Microsoft Simple Audio Sample.
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[AW_Input.NT.Wdf]
KmdfService=AuralWeaveVirtualAudio,AW.Wdf

[AW_Output.NT.Wdf]
KmdfService=AuralWeaveVirtualAudio,AW.Wdf

[AW.Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
ProviderName="AuralWeave"
MfgName="AuralWeave"
AW.Service.Desc="AuralWeave Virtual Audio Kernel Prototype"

KSNAME_WaveSpeaker="WaveSpeaker"
KSNAME_TopologySpeaker="TopologySpeaker"
KSNAME_WaveMicArray1="WaveMicArray1"
KSNAME_TopologyMicArray1="TopologyMicArray1"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY="{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"

AW.Input.Friendly="AuralWeave Virtual Input"
AW.Input.Topology="AuralWeave Virtual Input Topology"
AW.Output.Friendly="AuralWeave Virtual Output"
AW.Output.Topology="AuralWeave Virtual Output Topology"
AW.Input.0001 = "AuralWeave Virtual Input 01"
AW.Output.0001 = "AuralWeave Virtual Output 01"
