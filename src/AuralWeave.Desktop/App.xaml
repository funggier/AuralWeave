<Application x:Class="AuralWeave.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#202A3B"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#AAB8CE"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E9EFF9"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E9EFF9"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Application.Resources>
</Application>
