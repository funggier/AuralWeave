<Window x:Class="AuralWeave.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AuralWeave — Audio Routing Studio" Width="1050" Height="810"
        MinWidth="800" MinHeight="600" Background="#131C2B"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#202A3B" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="23" FontWeight="Bold" Text="AuralWeave"/>
                    <TextBlock Foreground="#AAB8CE" Text="Modular Real-time Audio Routing  •  WASAPI prototype"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RefreshButton" Content="Refresh devices" Click="RefreshClicked"/>
                    <Button x:Name="StartButton" Content="Start route" Click="StartStopClicked" Background="#70E0AD" Foreground="#10261B" MinWidth="118"/>

                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#202A3B" Padding="14,10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="FrameCountLabel" Foreground="#AAB8CE" Text="0 frames"/>
                <TextBlock x:Name="StatusLabel" Foreground="#70E0AD" TextWrapping="Wrap" Text="Ready — no audio running"/>
            </DockPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="22" MaxWidth="950">
                <Border Background="#202A3B" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="1  Input source" Margin="0,0,0,10"/>
                        <ComboBox x:Name="InputCombo" DisplayMemberPath="DisplayName"/>
                        <CheckBox x:Name="NativeToggle" Margin="0,11,0,2" Content="Native C++ engine (low-latency preview; uncheck for compatibility mode)" IsChecked="False"/>
                        <TextBlock Margin="0,9,0,3" Foreground="#AAB8CE" Text="Input signal"/>
                        <ProgressBar x:Name="InputLevel" Minimum="0" Maximum="100" Height="12" Value="0" Foreground="#70E0AD" Background="#37455B"/>
                        <TextBlock Foreground="#AAB8CE" Margin="0,9,0,0" Text="Mic / Line In or Windows playback loopback • selects active device endpoint"/>
                    </StackPanel>
                </Border>
                <Border Background="#202A3B" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="2  Noise reduction" Margin="0,0,0,10"/>
                        <ComboBox SelectedIndex="0" x:Name="NoiseCombo">
                            <ComboBoxItem Content="Bypass — direct routing (active)"/>
                            <ComboBoxItem Content="RNNoise — coming in a later phase" IsEnabled="False"/>
                        </ComboBox>
                        <TextBlock Foreground="#AAB8CE" Margin="0,9,0,0" TextWrapping="Wrap"
                                   Text="Noise reduction is bypassed in this build. The gain effects below are independently active."/>
                    </StackPanel>
                </Border>
                <Border Background="#202A3B" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="+ Add gain effect" Click="AddEffectClicked"/>
                            <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="SemiBold" Text="3  Effects chain"/>
                        </DockPanel>
                        <StackPanel x:Name="EffectsPanel"/>
                        <TextBlock Foreground="#AAB8CE" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="Repeated gain effects are supported with independent settings, bypass, and ordering. EQ / Voice / AI effects are future modules."/>
                    </StackPanel>
                </Border>
                <Border Background="#202A3B" CornerRadius="10" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="4  Output devices" Margin="0,0,0,10"/>
                        <StackPanel x:Name="OutputPanel" Margin="0,0,0,9"/>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" x:Name="AddOutputButton" Content="+ Add" Click="AddOutputClicked"/>
                            <ComboBox x:Name="OutputChoiceCombo" DisplayMemberPath="DisplayName" Margin="0,2,8,2"/>
                        </DockPanel>
                        <TextBlock x:Name="OutputHint" Foreground="#AAB8CE" Margin="0,9,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="#202A3B" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock FontSize="17" FontWeight="SemiBold" Text="Live status"/>
                        <TextBlock x:Name="DeviceCountLabel" Foreground="#AAB8CE" Margin="0,7,0,0"/>
                        <TextBlock x:Name="OutputStatusLabel" Foreground="#AAB8CE" Margin="0,7,0,0" TextWrapping="Wrap"/>
                        <TextBlock Foreground="#AAB8CE" Margin="0,9,0,0" TextWrapping="Wrap"
                                   Text="Native C++ uses per-output buffering • Managed WASAPI remains available as fallback"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
