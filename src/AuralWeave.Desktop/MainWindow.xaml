<Window x:Class="AuralWeave.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AuralWeave — Audio Routing Studio"
        Icon="Assets/AuralWeave.ico"
        Width="1060" Height="840" MinWidth="820" MinHeight="630"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <DockPanel>
        <!-- Fully themed window chrome; system resizing/snap still handled by WindowChrome. -->
        <Border DockPanel.Dock="Top" Height="39"
                Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource PanelStroke}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBarMouseLeftButtonDown"
                MouseRightButtonUp="TitleBarMouseRightButtonUp">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                            IsHitTestVisible="False">
                    <Image Width="21" Height="21" Source="Assets/AuralWeave-Monochrome.png"
                           Margin="0,0,9,0"/>
                    <TextBlock Text="AuralWeave" FontWeight="SemiBold" FontSize="12"
                               Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center"/>
                    <TextBlock Text="  —  Audio Routing Studio" FontSize="12"
                               Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource WindowCaptionButton}" Content="—"
                            AutomationProperties.Name="Minimize" ToolTip="Minimize"
                            Click="MinimizeWindowClicked"/>
                    <Button x:Name="MaximizeWindowButton" Style="{StaticResource WindowCaptionButton}"
                            Content="□" AutomationProperties.Name="Maximize or restore"
                            ToolTip="Maximize / Restore" Click="MaximizeWindowClicked"/>
                    <Button Style="{StaticResource WindowCloseButton}" Content="×"
                            AutomationProperties.Name="Close" ToolTip="Close"
                            Click="CloseWindowClicked"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource PanelStroke}" BorderThickness="0,0,0,1"
                Padding="26,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="48" Height="48" Source="Assets/AuralWeave-Monochrome.png"
                           Margin="0,0,14,0" Stretch="Uniform"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AuralWeave" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="NATIVE AUDIO ROUTING" FontSize="11"
                                   Foreground="{DynamicResource SecondaryText}"
                                   />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SKIN" Foreground="{DynamicResource SecondaryText}"
                               FontSize="11" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <ComboBox x:Name="SkinCombo" Width="158"
                              SelectedIndex="0" SelectionChanged="SkinChanged" Margin="0,0,10,0">
                        <ComboBoxItem Content="Monochrome Dark"/>
                        <ComboBoxItem Content="Graphite"/>
                    </ComboBox>
                    <StackPanel x:Name="StudioHeaderActions" Orientation="Horizontal">
                    <Button x:Name="RefreshButton" Content="↻  Refresh devices"
                            Click="RefreshClicked" Margin="0,0,8,0"/>
                    <Button x:Name="StartButton" Content="START" Click="StartStopClicked"
                            Background="{DynamicResource Accent}"
                            Foreground="{DynamicResource AccentText}" MinWidth="120"
                            FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource PanelStroke}" BorderThickness="0,1,0,0"
                Padding="22,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Accent}"
                             Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusLabel" TextWrapping="Wrap"
                               Text="Ready — no route running"
                               Foreground="{DynamicResource Accent}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="FrameCountLabel" Text="0 frames"
                           Foreground="{DynamicResource SecondaryText}"/>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="1020" Margin="24,24,24,18">
                <!-- Two-mode selector; the Virtual Driver page contains TWO cards,
                     one for each direction, on the SAME page. -->
                <Grid Margin="0,0,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="StudioModeButton" Grid.Column="0" Content="STUDIO"
                            FontWeight="SemiBold" Height="48" Margin="0,0,12,0"
                            Click="ShowStudioModeClicked"
                            Background="{DynamicResource Accent}"
                            Foreground="{DynamicResource AccentText}"/>
                    <Button x:Name="VirtualModeButton" Grid.Column="1" Content="VIRTUAL DRIVER"
                            FontWeight="SemiBold" Height="48" Margin="12,0,0,0"
                            Click="ShowVirtualDriverModeClicked"/>
                </Grid>
                <StackPanel x:Name="StudioPanel">
                <Border Style="{StaticResource StageCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <TextBlock Style="{StaticResource SectionHeader}"
                                       Text="01    SOUND INPUT" Margin="0" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="Source"
                                       Foreground="{DynamicResource SecondaryText}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <ComboBox x:Name="InputCombo" DisplayMemberPath="DisplayName"/>
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="InputLevel" Minimum="0" Maximum="100"
                                         Height="8" Background="{DynamicResource SubtleBackground}"
                                         Foreground="{DynamicResource Accent}" Value="0"
                                         VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="INPUT LEVEL" FontSize="10"
                                       TextAlignment="Right" Foreground="{DynamicResource SecondaryText}"
                                       VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </Grid>
                        <TextBlock Text="Microphone · Line In · Playback loopback"
                                   Style="{StaticResource MutedCaption}" Margin="0,11,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="↓" Foreground="{DynamicResource SecondaryText}" FontSize="18"
                           HorizontalAlignment="Center" Margin="0,-11,0,5"/>

                <Border Style="{StaticResource StageCard}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,14">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SectionHeader}" Text="02    FILTERS"
                                           Margin="0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="FilterCountLabel" Text="  ·  direct path"
                                           Foreground="{DynamicResource SecondaryText}"
                                           VerticalAlignment="Center" Margin="8,1,0,0"/>
                            </StackPanel>
                            <Button x:Name="GlobalFilterExpandButton" DockPanel.Dock="Right"
                                    Content="Collapse all" Click="ToggleAllFiltersClicked"
                                    MinWidth="112" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <Border Background="{DynamicResource SubtleBackground}"
                                BorderBrush="{DynamicResource PanelStroke}"
                                BorderThickness="1" CornerRadius="8" Padding="12"
                                Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="FILTER PRESETS" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}"
                                           Margin="0,0,0,9"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="PresetCombo" DisplayMemberPath="Name"
                                              MinWidth="190" Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" Content="LOAD"
                                            Click="LoadPresetClicked" Padding="12,7" Margin="0,2,7,2"/>
                                    <Button Grid.Column="2" Content="REFRESH"
                                            Click="RefreshPresetsClicked" Padding="10,7" Margin="5,2,2,2"/>
                                </Grid>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PresetNameBox" Text="My Filters"
                                             ToolTip="Filter preset name; source and output devices are never saved"
                                             Padding="10,8" MinHeight="36"
                                             Background="{DynamicResource FieldBackground}"
                                             Foreground="{DynamicResource PrimaryText}"
                                             BorderBrush="{DynamicResource FieldStroke}"
                                             BorderThickness="1" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="SAVE"
                                            Click="SavePresetClicked" Margin="12,2,5,2"/>
                                    <Button Grid.Column="2" Content="IMPORT"
                                            Click="ImportPresetClicked" Margin="5,2,5,2"/>
                                    <Button Grid.Column="3" Content="EXPORT"
                                            Click="ExportPresetClicked" Margin="5,2,2,2"/>
                                </Grid>
                                <TextBlock Text="Preset saves only Filter types, settings, enabled states, and order — never Sound Input or Output."
                                           Style="{StaticResource MutedCaption}" FontSize="11"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>                        <StackPanel x:Name="FiltersPanel" Margin="0,0,0,12"/>
                        <Button x:Name="AddFilterButton" Style="{StaticResource AddFilterButton}"
                                Content="+" Click="AddFilterClicked"
                                ToolTip="Add an empty filter slot"/>
                        <TextBlock x:Name="FilterHelpText" Style="{StaticResource MutedCaption}"
                                   Text="No filters selected — audio goes straight from input to output."
                                   Margin="0,12,0,0" TextAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="↓" Foreground="{DynamicResource SecondaryText}" FontSize="18"
                           HorizontalAlignment="Center" Margin="0,-11,0,5"/>

                <Border Style="{StaticResource StageCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="03    SOUND OUTPUT"/>
                        <StackPanel x:Name="OutputPanel" Margin="0,0,0,12"/>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" x:Name="AddOutputButton"
                                    Content="+ Add output" Click="AddOutputClicked"
                                    Margin="7,0,0,0"/>
                            <ComboBox x:Name="OutputChoiceCombo"
                                      DisplayMemberPath="DisplayName"/>
                        </DockPanel>
                        <TextBlock x:Name="OutputHint" Style="{StaticResource MutedCaption}"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StageCard}" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="LIVE STATUS"/>
                        <TextBlock x:Name="DeviceCountLabel" Style="{StaticResource MutedCaption}"
                                   Margin="0,0,0,8"/>
                        <TextBlock x:Name="OutputStatusLabel" Style="{StaticResource MutedCaption}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Windows Native C++ WASAPI · Event-driven outputs · Per-output buffering"
                                   Style="{StaticResource MutedCaption}"/>
                    </StackPanel>
                </Border>
                </StackPanel>
                <StackPanel x:Name="VirtualDriverPanel" Visibility="Collapsed">
                    <TextBlock Text="VIRTUAL DRIVER MANAGEMENT"
                               FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Windows shares the same virtual devices across AuralWeave portable copies. Each copy uses Studio independently; only one copy controls each virtual role at a time."
                               Style="{StaticResource MutedCaption}" Margin="0,0,0,14"/>
                    <Button x:Name="RefreshVirtualDriversButton"
                            Content="REFRESH INSTALLED DEVICES" HorizontalAlignment="Left"
                            Click="RefreshVirtualDriversClicked" Margin="0,0,0,17"/>
                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}"
                                       Text="VIRTUAL INPUT (MAX 1)"/>
                            <TextBlock Style="{StaticResource MutedCaption}"
                                       Text="One Windows recording endpoint per computer: other apps select it as a microphone."/>
                            <StackPanel x:Name="VirtualInputDevices" Margin="0,16,0,16"/>
                            <Button x:Name="InstallVirtualInputButton"
                                    Content="+ INSTALL VIRTUAL INPUT"
                                    IsEnabled="False" HorizontalAlignment="Left"
                                    Click="InstallVirtualInputClicked"/>
                            <TextBlock x:Name="VirtualInputPackageStatus" Style="{StaticResource MutedCaption}"
                                       Margin="0,13,0,0"
                                       Text="Installation unavailable: unsigned Windows 10/11 driver prototype is not yet audio-bridged or Microsoft-signed."/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource StageCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionHeader}"
                                       Text="VIRTUAL OUTPUT (MAX 1)"/>
                            <TextBlock Style="{StaticResource MutedCaption}"
                                       Text="One Windows playback endpoint per computer: other apps play audio into it."/>
                            <StackPanel x:Name="VirtualOutputDevices" Margin="0,16,0,16"/>
                            <Button x:Name="InstallVirtualOutputButton"
                                    Content="+ INSTALL VIRTUAL OUTPUT"
                                    IsEnabled="False" HorizontalAlignment="Left"
                                    Click="InstallVirtualOutputClicked"/>
                            <TextBlock x:Name="VirtualOutputPackageStatus" Style="{StaticResource MutedCaption}"
                                       Margin="0,13,0,0"
                                       Text="Installation unavailable: unsigned Windows 10/11 driver prototype is not yet audio-bridged or Microsoft-signed."/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="VirtualDriverSummary" Style="{StaticResource MutedCaption}"
                               Margin="0,2,0,16"
                               Text="Windows driver installation/removal requires administrator approval. No test-signing changes are made automatically."/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
