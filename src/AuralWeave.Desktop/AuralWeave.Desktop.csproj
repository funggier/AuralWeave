<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>AuralWeave</AssemblyName>
    <ApplicationIcon>Assets\AuralWeave.ico</ApplicationIcon>
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <FileVersion>0.5.0.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AuralWeave.Audio.Windows\AuralWeave.Audio.Windows.csproj" />
    <Resource Include="Assets\AuralWeave.ico" />
    <Resource Include="Assets\AuralWeave-Monochrome.png" />
  </ItemGroup>
</Project>
